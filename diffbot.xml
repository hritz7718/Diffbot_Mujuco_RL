<mujoco model="DiffBot">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>
  <statistic center="0 0 0.1" extent="1.2"/>
  <visual><global azimuth="135" elevation="-25"/><headlight ambient="0.4 0.4 0.4"/></visual>
  <default>
    <geom friction="0.8 0.005 0.0001" condim="3"/>
    <default class="visual"><geom contype="0" conaffinity="0" group="2" mass="0"/></default>
  </default>
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.18 0.23 0.29" rgb2="0.28 0.34 0.41" width="256" height="256"/>
    <material name="floor_mat" texture="grid" texrepeat="10 10" texuniform="true"/>
  </asset>
  <worldbody>
    <light pos="0 -1 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="floor_mat"/>
    <body name="base_link" pos="0 0 0.075">
      <freejoint name="floating_base"/>
      <inertial pos="0 0 0" mass="2" diaginertia="0.00913 0.01607 0.02307"/>
      <geom name="chassis" type="box" size="0.15 0.11 0.04" rgba="0.1 0.3 0.9 1"/>
      <site name="base_footprint" pos="0 0 -0.075" size="0.001" rgba="0 0 0 0"/>
      <body name="left_wheel_link" pos="0.1 0.13 -0.035">
        <joint name="left_wheel_joint" axis="0 1 0" damping="0.2" frictionloss="0.1"/>
        <inertial pos="0 0 0" mass="0.2" diaginertia="0.0000717 0.0001225 0.0000717"/>
        <geom name="left_wheel" type="cylinder" size="0.035 0.0125" euler="1.5707963267948966 0 0" rgba="0.01 0.01 0.01 1"/>
        <geom class="visual" type="box" pos="0 0.013 0" size="0.028 0.001 0.003" rgba="0.8 0.8 0.8 1"/>
      </body>
      <body name="right_wheel_link" pos="0.1 -0.13 -0.035">
        <joint name="right_wheel_joint" axis="0 1 0" damping="0.2" frictionloss="0.1"/>
        <inertial pos="0 0 0" mass="0.2" diaginertia="0.0000717 0.0001225 0.0000717"/>
        <geom name="right_wheel" type="cylinder" size="0.035 0.0125" euler="1.5707963267948966 0 0" rgba="0.01 0.01 0.01 1"/>
        <geom class="visual" type="box" pos="0 -0.013 0" size="0.028 0.001 0.003" rgba="0.8 0.8 0.8 1"/>
      </body>
      <body name="caster_wheel_link" pos="-0.11 0 -0.055">
        <inertial pos="0 0 0" mass="0.05" diaginertia="0.00000648 0.00000648 0.00000648"/>
        <geom name="caster" type="sphere" size="0.018" friction="0.05 0.001 0.0001" priority="1" rgba="0.5 0.5 0.5 1"/>
      </body>
      <geom class="visual" name="laser_visual" type="cylinder" pos="0.08 0 0.065" size="0.035 0.0125" rgba="0.9 0.1 0.1 1"/>
      <geom class="visual" name="camera_visual" type="box" pos="0.15 0 0.03" size="0.02 0.0125 0.0125" rgba="0.5 0.5 0.5 1"/>
      <geom class="visual" name="imu_visual" type="box" pos="0 0 0.055" size="0.015 0.015 0.005" rgba="0.01 0.01 0.01 1"/>
      <site name="imu" pos="0 0 0.055" size="0.002" rgba="0 0 0 0"/>
      <camera name="front_camera" pos="0.15 0 0.03" xyaxes="0 -1 0 0 0 1" fovy="46.817"/>
    </body>
  </worldbody>
  <actuator>
    <velocity name="left_wheel_speed" joint="left_wheel_joint" kv="1" ctrlrange="-6 6" forcerange="-1 1"/>
    <velocity name="right_wheel_speed" joint="right_wheel_joint" kv="1" ctrlrange="-6 6" forcerange="-1 1"/>
  </actuator>
  <sensor>
    <jointpos name="left_encoder" joint="left_wheel_joint"/>
    <jointpos name="right_encoder" joint="right_wheel_joint"/>
    <jointvel name="left_speed" joint="left_wheel_joint"/>
    <jointvel name="right_speed" joint="right_wheel_joint"/>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_acceleration" site="imu"/>
  </sensor>
</mujoco>
